# Python
.venv/
__pycache__/
.pytest_cache/

# Système et éditeur
.DS_Store
.vscode/

# Corpus : les textes bruts se régénèrent avec les scripts d'ingestion.
# Les 3 fichiers finaux sont versionnés, car l'API en ligne en a besoin.
backend/corpus/*
!backend/corpus/passages.jsonl
!backend/corpus/vecteurs.npy
!backend/corpus/index.json

# Modèle d'embeddings (téléchargé par : python -m app.encodeur --telecharger)
backend/modele/

# Secrets (clé API) : aucun fichier .env ne doit partir sur GitHub
.env
.env.*
!.env.example

# Next.js
frontend/node_modules/
frontend/.next/
*.tsbuildinfo
