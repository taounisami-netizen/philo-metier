# Copie ce fichier en .env (même dossier) et mets ta vraie clé.
# Le fichier .env est ignoré par Git : ta clé ne partira jamais sur GitHub.
# En ligne, ces valeurs se mettent dans les « secrets » de l'hébergeur, pas dans un fichier.

ANTHROPIC_API_KEY=sk-ant-...
# Optionnel : modèle utilisé (défaut claude-sonnet-5-5)
# CLAUDE_MODEL=claude-haiku-5-5

# --- Uniquement pour la mise en ligne ---------------------------------------
# PRODUCTION=1                     # masque /docs et réduit /api/sante
# CLE_INTERNE=une-longue-chaine-aleatoire
#   Secret partagé avec le site Next.js (même valeur des deux côtés) : seul le site
#   peut alors appeler l'API. Pour en générer un : python -c "import secrets; print(secrets.token_urlsafe(32))"
# CORS_ORIGINS=https://ton-site.vercel.app

# Limites (valeurs par défaut) :
# LIMITE_PAR_MINUTE=5              # résultats par minute et par visiteur
# LIMITE_PAR_JOUR=60               # résultats par jour et par adresse IP (une entreprise partage souvent la même)
# LIMITE_LLM_PAR_JOUR=300          # appels à Claude par jour pour tout le site (puis mode démo)
